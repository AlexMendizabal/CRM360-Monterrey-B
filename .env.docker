# =============================================================
# CRM360 Monterrey - Variables de entorno
# =============================================================
# Copiar a .env.local y editar con tus credenciales:
#   cp .env.docker .env.local
# =============================================================

# --- Symfony ---
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_env_local
JWT_SECRET=change_me_in_env_local

# --- Puerto de la app ---
APP_PORT=8080

# --- SQL Server (tu servidor externo) ---
DB_DRIVER=pdo_sqlsrv
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=CRM360
DB_USER=sa
DB_PASSWORD=123

# Si SQL Server esta en otra maquina de la red:
# DB_HOST=192.168.0.100

# --- SAP ---
SAP_API_URL=http://192.168.0.123:4100/api
SAP_AUTH_USER=crm360

# --- Mail (PHPMailer) ---
MAIL_HOST=mail.ingbolivia.com
MAIL_PORT=465
MAIL_USERNAME=testcrm@ingbolivia.com
MAIL_PASSWORD=TU_PASSWORD_AQUI
MAIL_ENCRYPTION=ssl

# --- Akna (Email Marketing) ---
AKNA_USER=TU_USER_AQUI
AKNA_PASSWORD=TU_PASSWORD_AQUI
AKNA_CLIENT=TU_CLIENT_AQUI
AKNA_URL=https://app.akna.com.br/emkt/int/integracao.php

# --- PHP OPcache (0=off para dev, 1=on para prod) ---
PHP_OPCACHE_ENABLE=0
PHP_OPCACHE_VALIDATE=1
